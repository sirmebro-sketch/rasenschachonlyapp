<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      One UI/Android may crop the outer adaptive-icon area. Keep the complete
      artwork inside a 78dp square (15dp inset on the 108dp adaptive canvas)
      so the full RASENSCHACH word stays inside the launcher safe area.
    -->
    <item
        android:left="15dp"
        android:top="15dp"
        android:right="15dp"
        android:bottom="15dp">
        <bitmap
            android:src="@drawable/app_icon_source"
            android:gravity="fill"
            android:filter="true" />
    </item>
</layer-list>
